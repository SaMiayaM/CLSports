# ─────────────────────────────────────────────────────────────
# Square — Frontend (public, safe for browser via Vite)
# Vite requires VITE_ prefix to expose to client. These are NOT secrets.
# ─────────────────────────────────────────────────────────────
VITE_SQUARE_APPLICATION_ID=sandbox-sq0idb-xxxxxxxxxxxxxxxxxxxxxx
VITE_SQUARE_LOCATION_ID=LXXXXXXXXXXXXXXXXXXXXX

# ─────────────────────────────────────────────────────────────
# Square — Backend (server-only, never expose to browser)
# Store in hosting platform encrypted env vars, not in Git.
# ─────────────────────────────────────────────────────────────
# sandbox = test cards, production = real cards
SQUARE_ENVIRONMENT=sandbox
# Values must match Square Developer Dashboard for the chosen environment
SQUARE_APPLICATION_ID=sandbox-sq0idb-xxxxxxxxxxxxxxxxxxxxxx
SQUARE_LOCATION_ID=LXXXXXXXXXXXXXXXXXXXXX
SQUARE_ACCESS_TOKEN=EAAAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SQUARE_WEBHOOK_SIGNATURE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# App / Database
# ─────────────────────────────────────────────────────────────
# Postgres connection (Netlify + Neon/Supabase/Vercel Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional: used to build absolute webhook URL for signature verification
# Leave empty to auto-detect from request headers
PUBLIC_SITE_URL=https://your-site.netlify.app

# Netlify / hosting: do NOT prefix server secrets with VITE_
# Netlify Dashboard → Site settings → Environment variables → add each above
# For GitHub Actions (if needed): Settings → Secrets and variables → Actions → New repository secret
